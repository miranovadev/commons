        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.8.2"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.4"
